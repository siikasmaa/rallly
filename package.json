{
  "name": "rallly2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun x @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro dev",
    "build": "bun x @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && astro build",
    "i18n:compile": "bun x @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "preview": "astro preview",
    "start": "astro preview",
    "lint": "eslint .",
    "lint:tsc": "astro check && bun run tsc --noEmit",
    "test": "bun x playwright test",
    "db:generate": "bun x drizzle-kit generate",
    "db:migrate": "bun x drizzle-kit migrate"
  },
  "dependencies": {
