---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Page Not Found">
  <div class="flex h-screen items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold text-gray-800">404</h1>
      <p class="mt-2 text-gray-600">Page not found</p>
      <a
        href="/"
        class="mt-4 inline-block rounded-lg bg-primary-600 px-4 py-2 text-white hover:bg-primary-700"
      >
        Go Home
      </a>
    </div>
  </div>
</BaseLayout>
