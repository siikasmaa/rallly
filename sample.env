# Rallly Environment Variables
# For Cloudflare Workers/Pages deployment, use wrangler.toml [vars] and
# `wrangler secret put <NAME>` for secrets.

# App URL (default: http://localhost:4321 for dev)
PUBLIC_BASE_URL=http://localhost:4321

# Session encryption key (minimum 32 characters)
SECRET_PASSWORD=minimum-32-characters-required-here

# Email sender address
SUPPORT_EMAIL=foo@yourdomain.com

# API secret for house-keeping endpoint
API_SECRET=your-api-secret

# Sentry DSN (optional)
# SENTRY_DSN=https://your-sentry-dsn
